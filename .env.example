# URL JDBC de PostgreSQL, por ejemplo: jdbc:postgresql://host:5432/nombre_base
DB_URL=jdbc:postgresql://localhost:5432/adopet_db
DB_USERNAME=postgres
DB_PASSWORD=pega_aqui_tu_password

# Reemplaza el valor antes de usar autenticacion; debe tener al menos 32 caracteres.
JWT_SECRET=cambia-por-una-clave-secreta-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=3600000

# Configuracion SMTP necesaria para enviar correos (opcional si no se usa esa funcion).
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Bootstrap opcional del primer administrador. Usa datos propios y desactívalo
# con ADMIN_BOOTSTRAP_ENABLED=false después del primer inicio exitoso.
ADMIN_BOOTSTRAP_ENABLED=false
# Activar temporalmente solo para cambiar la contraseña de un admin existente.
ADMIN_BOOTSTRAP_RESET_PASSWORD=false
ADMIN_NAME=
ADMIN_DOCUMENT=
ADMIN_EMAIL=
ADMIN_PASSWORD=
